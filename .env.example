# Environment variables (example)

# Lyzr Safe AI
LYZR_SAFE_AI_URL=https://api.lyzr.example/safe_ai/redact
LYZR_SAFE_AI_API_KEY=replace-me

# Lyzr Agent API
LYZR_AGENT_API_URL=https://api.lyzr.example/agents
LYZR_AGENT_API_KEY=replace-me

# Audit signing (HMAC for dev; use PKI/HSM in prod)
AUDIT_HMAC_KEY=replace-me

# Database / storage
DATABASE_URL=postgresql://user:pass@localhost:5432/lyzr

# AIMS / event streamer
AIMS_ENDPOINT=https://aims.lyzr.example/stream
AIMS_API_KEY=replace-me
